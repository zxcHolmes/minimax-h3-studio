# Copy to .env and fill in. .env is git-ignored; never commit it.
# deploy.sh, the systemd unit it installs and `npm run dev` all read these.

# --- Required -------------------------------------------------------------

# SSH target of the GPU machine (key-based login; the user needs sudo for systemd).
H3_DEPLOY_HOST=user@gpu-host

# ComfyUI checkout on the GPU machine, with the MiniMax-H3 models in its models/ folders.
H3_COMFYUI=/path/to/ComfyUI

# --- Python environment on the GPU machine (pick one) -----------------------

# Conda env that runs ComfyUI.
H3_CONDA_ENV=comfyui
# conda.sh to source; empty = ~/miniconda3/etc/profile.d/conda.sh of the service user.
H3_CONDA_SH=

# Or: an absolute python interpreter (venv etc.). When set, the conda settings are ignored.
H3_PYTHON=

# --- Optional ---------------------------------------------------------------

# Install directory on the GPU machine; empty = ~/minimax-h3-studio of the SSH user.
H3_DEPLOY_DIR=
# User the service runs as; empty = the SSH user.
H3_SERVICE_USER=
# systemd unit name.
H3_SERVICE=h3-server

# Address the server listens on.
H3_HOST=0.0.0.0
H3_PORT=8190

# Extra ComfyUI CLI flags. Triton + SageAttention roughly halve generation time;
# remove them if those packages are not installed in the env.
H3_COMFY_ARGS="--enable-triton-backend --use-sage-attention"

# Model downloads (scripts/prepare_models.py, ./deploy.sh models).
# Hugging Face mirror, e.g. https://hf-mirror.com; empty = huggingface.co.
HF_ENDPOINT=
# Only needed for gated or private repos.
HF_TOKEN=

# Where `npm run dev` proxies /api and /files; empty = http://<H3_DEPLOY_HOST host>:<H3_PORT>.
H3_API=

# Native audio.cpp CUDA runtime and selected GGUF packages.
# Empty = sibling audio_cpp/ directory next to H3_COMFYUI (keeps weights on the same SSD).
H3_AUDIOCPP_DIR=
# Loopback-only child server, managed by the Studio worker.
H3_AUDIOCPP_PORT=8191
H3_AUDIOCPP_THREADS=8
# Timeout for one native speech/ASR request in seconds.
H3_AUDIOCPP_TIMEOUT=1800
